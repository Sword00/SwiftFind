#include <windows.h>
#include "version.h"

1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SF_VER_MAJOR,SF_VER_MINOR,SF_VER_PATCH,0
PRODUCTVERSION SF_VER_MAJOR,SF_VER_MINOR,SF_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "SwiftFind"
            VALUE "FileDescription",  "SwiftFind - tiny app and file launcher"
            VALUE "FileVersion",      SF_VER_STR4
            VALUE "InternalName",     "SwiftFind"
            VALUE "OriginalFilename", "SwiftFind.exe"
            VALUE "ProductName",      "SwiftFind"
            VALUE "ProductVersion",   SF_VER_STR4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
